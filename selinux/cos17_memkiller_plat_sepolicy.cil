;; ==========================================================================
;; cos17_memkiller SELinux CIL policy (append to plat_sepolicy.cil & plat_sepolicy_debug.cil)
;; Also add `cos17_memkiller` to the neverallow exclusion list for device_config_lmkd_native_prop
;; (e.g., base_typeattr_1063 on Android 16/17 ColorOS) and file_contexts:
;;   /vendor/bin/memkiller_ctl\.sh   u:object_r:cos17_memkiller_exec:s0
;; ==========================================================================
(type cos17_memkiller)
(type cos17_memkiller_exec)
(roletype object_r cos17_memkiller_exec)
(typeattributeset domain (cos17_memkiller))
(typeattributeset coredomain (cos17_memkiller))
(typeattributeset system_executes_vendor_violators (cos17_memkiller))
(typeattributeset file_type (cos17_memkiller_exec))
(typeattributeset exec_type (cos17_memkiller_exec))
(typeattributeset vendor_file_type (cos17_memkiller_exec))
(allow init cos17_memkiller_exec (file (read getattr map execute open)))
(allow init cos17_memkiller (process (transition siginh rlimitinh)))
(dontaudit init cos17_memkiller (process (noatsecure)))
(typetransition init cos17_memkiller_exec process cos17_memkiller)

(allow cos17_memkiller shell_exec (file (entrypoint read open getattr map execute)))
(allow cos17_memkiller cos17_memkiller_exec (file (read open getattr map)))
(allow cos17_memkiller toolbox_exec (file (read open getattr map execute execute_no_trans)))
(allow cos17_memkiller system_file (file (read open getattr map execute execute_no_trans)))
(allow cos17_memkiller system_file (lnk_file (read getattr)))
(allow cos17_memkiller shell_exec (lnk_file (read getattr)))
(allow cos17_memkiller toolbox_exec (lnk_file (read getattr)))
(allow cos17_memkiller vendor_file (dir (search)))
(allow cos17_memkiller vendor_file (lnk_file (read getattr)))
(allow cos17_memkiller system_lib_file (file (read open getattr map)))
(allow cos17_memkiller system_bootstrap_lib_file (file (read open getattr map)))
(allow cos17_memkiller system_linker_exec (file (read open getattr map execute)))
(allow cos17_memkiller system_linker_config_file (file (read open getattr map)))

(allow cos17_memkiller self (process (fork sigchld getpgid getsched)))
(allow cos17_memkiller self (capability (kill)))
(allow cos17_memkiller self (fd (use)))
(allow cos17_memkiller cos17_memkiller (dir (search read open getattr)))
(allow cos17_memkiller cos17_memkiller (file (read open getattr)))
(allow cos17_memkiller cos17_memkiller (lnk_file (read)))
(allow cos17_memkiller cos17_memkiller (fifo_file (create read write getattr)))
(allow cos17_memkiller null_device (chr_file (read write open getattr map ioctl)))
(allow cos17_memkiller zero_device (chr_file (read open getattr map)))

(allow cos17_memkiller logd_socket (sock_file (write getattr)))
(allow cos17_memkiller logd (unix_stream_socket (connectto)))
(allow cos17_memkiller logd_prop (file (read open getattr map)))

(allow cos17_memkiller default_prop (file (read open getattr map)))
(allow cos17_memkiller system_prop (file (read open getattr map)))
(allow cos17_memkiller system_prop (property_service (set)))
(allow cos17_memkiller system_lmk_prop (file (read open getattr map)))
(allow cos17_memkiller system_lmk_prop (property_service (set)))
(allow cos17_memkiller device_config_lmkd_native_prop (file (read open getattr map)))
(allow cos17_memkiller device_config_lmkd_native_prop (property_service (set)))
(allow cos17_memkiller property_socket (sock_file (write)))
(allow cos17_memkiller init (unix_stream_socket (connectto)))

(allow cos17_memkiller proc (dir (search read open getattr)))
(allow cos17_memkiller proc (lnk_file (read getattr)))
(allow cos17_memkiller proc_meminfo (file (read open getattr)))
(allow cos17_memkiller proc_uptime (file (read open getattr)))
(allow cos17_memkiller proc_watermark_scale_factor (file (read write open getattr)))
(allow cos17_memkiller lmkd (dir (search read open getattr)))
(allow cos17_memkiller lmkd (file (read open getattr)))
(allow cos17_memkiller lmkd (process (signal sigstop getsched)))
(allow cos17_memkiller system_server (dir (search read open getattr)))
(allow cos17_memkiller system_server (file (read open getattr)))
(allow cos17_memkiller system_server (process (getattr)))

(allow cos17_memkiller activity_service (service_manager (find)))
(allow cos17_memkiller device_config_service (service_manager (find)))
(allow cos17_memkiller settings_service (service_manager (find)))
(allow cos17_memkiller servicemanager (binder (call transfer)))
(allow servicemanager cos17_memkiller (binder (call transfer)))
(allow servicemanager cos17_memkiller (dir (search)))
(allow servicemanager cos17_memkiller (file (read open getattr)))
(allow servicemanager cos17_memkiller (process (getattr)))
(allow cos17_memkiller system_server (binder (call transfer)))
(allow system_server cos17_memkiller (binder (call transfer)))
(allow cos17_memkiller system_server (fd (use)))
(allow system_server cos17_memkiller (fd (use)))
(allow system_server cos17_memkiller (fifo_file (read write getattr)))
(allow system_server cos17_memkiller (dir (search)))
(allow system_server cos17_memkiller (file (open read getattr)))

(dontaudit cos17_memkiller self (capability (dac_override sys_ptrace)))
(dontaudit cos17_memkiller proc (file (read write open getattr)))
(dontaudit cos17_memkiller init_svc_debug_prop (file (read open getattr map)))
(dontaudit cos17_memkiller vendor_default_prop (file (read open getattr map)))
(dontaudit cos17_memkiller domain (dir (search read open getattr)))
(dontaudit cos17_memkiller domain (file (read open getattr)))
